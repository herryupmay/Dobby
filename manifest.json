{
  "manifest_version": 3,
  "name": "Dobby",
  "version": "0.3",
  "description": "A free house elf running on local Gemini Nano",
  "minimum_chrome_version": "138",
  "permissions": ["sidePanel"],
  "icons": {
    "16": "icons/dobby-16.png",
    "32": "icons/dobby-32.png",
    "48": "icons/dobby-48.png",
    "128": "icons/dobby-128.png"
  },
  "action": {
    "default_title": "Summon Dobby",
    "default_icon": {
      "16": "icons/dobby-16.png",
      "32": "icons/dobby-32.png",
      "48": "icons/dobby-48.png",
      "128": "icons/dobby-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
